{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Vite DEV server",
      "request": "launch",
      "type": "node",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite"],
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "Attach Browser",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "url": "http://localhost:5173/*",
      "webRoot": "${workspaceFolder}/src",
      "preLaunchTask": "Launch Browser",
      "presentation": {
        "hidden": true
      }
    }
  ],
  "compounds": [
    {
      "name": "Debug",
      "configurations": ["Launch Vite DEV server", "Attach Browser"],
      "stopAll": true
    }
  ]
}